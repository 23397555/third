<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Book Test Drive - BMW</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body style="background:#111; color:#fff; padding:40px;">
    <h1>Request a Test Drive</h1>
    
    <% if (!success) { %>
        <form action="/test-drive" method="POST" style="max-width:400px; display:flex; flex-direction:column; gap:15px; margin-top:20px;">
            <label>Your Name:</label>
            <input type="text" name="name" required style="padding:8px;">
            
            <label>Select Car Model:</label>
            <select name="carModel" style="padding:8px;">
                <option value="BMW 7 Series">BMW 7 Series</option>
                <option value="BMW X6">BMW X6</option>
                <option value="BMW X3">BMW X3</option>
            </select>

            <label>Preferred Date:</label>
            <input type="date" name="date" required style="padding:8px;">

            <button type="submit" class="btn-primary" style="border:none; cursor:pointer;">Submit Request</button>
        </form>
    <% } else { %>
        <div style="background:#222; padding:20px; border:1px solid green; margin-top:20px; max-width:400px;">
            <h3 style="color:lightgreen;">Test Drive Booked Successfully!</h3>
            <p>Name: <b><%= name %></b></p>
            <p>Car: <b><%= carModel %></b></p>
            <p>Date: <b><%= date %></b></p>
        </div>
    <% } %>

    <br><br>
    <a href="/" class="btn-primary" style="text-decoration:none;">Back to Home</a>
</body>
</html>